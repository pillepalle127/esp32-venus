e;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="lWire"><mxGeometry x="1036" y="611" width="8" height="8" as="geometry"/></mxCell><mxCell id="j10" value="" style="ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="lWire"><mxGeometry x="1036" y="761" width="8" height="8" as="geometry"/></mxCell><mxCell id="j11" value="" style="ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="lWire"><mxGeometry x="1036" y="821" width="8" height="8" as="geometry"/></mxCell><mxCell id="j12" value="" style="ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="lWire"><mxGeometry x="1036" y="851" width="8" height="8" as="geometry"/></mxCell><mxCell id="j13" value="" style="ellipse;fillColor=#d00000;strokeColor=#d00000;" vertex="1" parent="lWire"><mxGeometry x="646" y="821" width="8" height="8" as="geometry"/></mxCell><mxCell id="j14" value="" style="ellipse;fillColor=#d00000;strokeColor=#d00000;" vertex="1" parent="lWire"><mxGeometry x="646" y="911" width="8" height="8" as="geometry"/></mxCell><mxCell id="j15" value="" style="ellipse;fillColor=#d00000;strokeColor=#d00000;" vertex="1" parent="lWire"><mxGeometry x="646" y="1061" width="8" height="8" as="geometry"/></mxCell><mxCell id="j16" value="" style="ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="lWire"><mxGeometry x="256" y="701" width="8" height="8" as="geometry"/></mxCell><mxCell id="j17" value="" style="ellipse;fillColor=#111111;strokeColor=#111111;" vertex="1" parent="lWire"><mxGeometry x="1246" y="761" width="8" height="8" as="geometry"/></mxCell><mxCell id="title" value="ESP32-S3 auf Lochraster, Sicht von oben" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=20;fontStyle=1;" vertex="1" parent="lText"><mxGeometry x="87.5" y="30" width="1300" height="30" as="geometry"/></mxCell><mxCell id="sub" value="48 x 30 Löcher, Raster 2,54 mm. Drähte sind durchsichtig gezeichnet und laufen auf der Unterseite. Kreuzung ohne Punkt: keine Verbindung." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=12;" vertex="1" parent="lText"><mxGeometry x="87.5" y="62" width="1400" height="22" as="geometry"/></mxCell><mxCell id="key" value="Pfostenstecker, von oben nach unten:&lt;br&gt;MT681: GND, 3V3, Haus, WP&lt;br&gt;BME280 1: GND, 3V3, SDA, SCL&lt;br&gt;BME280 2: GND, 3V3, SDA, SCL&lt;br&gt;Im Plan: G = GND, 3 = 3V3, H = Haus, W = WP, D = SDA, C = SCL" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=9;" vertex="1" parent="lText"><mxGeometry x="350" y="198" width="342" height="108" as="geometry"/></mxCell><mxCell id="t0" value="5 V ein" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#111111;fontStyle=1;" vertex="1" parent="lText"><mxGeometry x="659" y="930" width="42" height="15" as="geometry"/></mxCell><mxCell id="t1" value="CAN zum BMS" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;fontColor=#111111;fontStyle=1;" vertex="1" parent="lText"><mxGeometry x="200" y="1041" width="120" height="15" as="geometry"/></mxCell><mxCell id="t2" value="E-Paper" style="text;html=1;align=center;verticalAlign=middle;fontSize=8;fontColor=#111111;fontStyle=1;horizontal=0;" vertex="1" parent="lText"><mxGeometry x="1140.5" y="255" width="15" height="210" as="geometry"/></mxCell><mxCell id="zl1" value="VE.Bus:&lt;br&gt;eigene Masse" style="text;html=1;align=left;fontSize=8;fontStyle=2;" vertex="1" parent="lText"><mxGeometry x="92" y="750.9" width="62" height="26" as="geometry"/></mxCell><mxCell id="zl2" value="RS485: eigene Masse" style="text;html=1;align=left;fontSize=9;fontStyle=2;" vertex="1" parent="lText"><mxGeometry x="1226" y="568.5" width="150" height="16" as="geometry"/></mxCell><mxCell id="zl3" value="CAN: eigene Masse" style="text;html=1;align=left;fontSize=9;fontStyle=2;" vertex="1" parent="lText"><mxGeometry x="200" y="1014" width="150" height="16" as="geometry"/></mxCell><mxCell id="usbt" value="USB-Stecker liegen hier drüber" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#495057;" vertex="1" parent="lText"><mxGeometry x="722" y="1063" width="285" height="16" as="geometry"/></mxCell><mxCell id="leg0" value="Farben" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=13;fontStyle=1;" vertex="1" parent="lText"><mxGeometry x="87.5" y="1111.5" width="260" height="20" as="geometry"/></mxCell><mxCell id="lg0" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#e8590c;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1146.5" as="sourcePoint"/><mxPoint x="127.5" y="1146.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt0" value="3V3" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1137.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg1" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d00000;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1165.5" as="sourcePoint"/><mxPoint x="127.5" y="1165.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt1" value="5 V" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1156.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg2" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#111111;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1184.5" as="sourcePoint"/><mxPoint x="127.5" y="1184.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt2" value="GND" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1175.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg3" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#d00000;strokeWidth=2.5;dashed=1;dashPattern=5 3;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1203.5" as="sourcePoint"/><mxPoint x="127.5" y="1203.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt3" value="isolierte 5 V" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1194.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg4" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#111111;strokeWidth=2.5;dashed=1;dashPattern=5 3;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1222.5" as="sourcePoint"/><mxPoint x="127.5" y="1222.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt4" value="isolierte Masse" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1213.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg5" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#1971c2;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1241.5" as="sourcePoint"/><mxPoint x="127.5" y="1241.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt5" value="VE.Bus" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1232.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg6" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#2b8a3e;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1260.5" as="sourcePoint"/><mxPoint x="127.5" y="1260.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt6" value="CAN" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1251.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg7" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#9c36b5;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1279.5" as="sourcePoint"/><mxPoint x="127.5" y="1279.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt7" value="RS485 JK-BMS" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1270.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg8" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#0b7285;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1298.5" as="sourcePoint"/><mxPoint x="127.5" y="1298.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt8" value="MT681" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1289.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg9" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#a0522d;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1317.5" as="sourcePoint"/><mxPoint x="127.5" y="1317.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt9" value="I²C" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1308.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="lg10" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#4c6ef5;strokeWidth=2.5;" edge="1" parent="lText"><mxGeometry width="50" height="50" relative="1" as="geometry"><mxPoint x="87.5" y="1336.5" as="sourcePoint"/><mxPoint x="127.5" y="1336.5" as="targetPoint"/></mxGeometry></mxCell><mxCell id="lt10" value="E-Paper" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="135.5" y="1327.5" width="200" height="18" as="geometry"/></mxCell><mxCell id="n1" value="Bauteile&lt;br&gt;Pfostenstecker: 3 x 1x4 direkt übereinander, Reihenabstand 2,54 mm.&lt;br&gt;Die beiden BME280 hängen parallel am selben I²C-Bus (0x76, 0x77).&lt;br&gt;ADuM1201 VE.Bus: oben neben den S3-Pins, U2-Seite zum S3 (U2 an 3V3, U1 an isolierten 5 V). Vier Drähte unter dem MAX13487-Modul zu VCC, TXD, RXD, GND.&lt;br&gt;IO6 (Lüfter) und IO3 (Relais 2): Die Bestückung steht nicht in diesem Plan.&lt;br&gt;Rosa Pins am S3: CMT2300A, oben am S3 angelötet. Unter dem S3 läuft kein Draht.&lt;br&gt;Unter den USB-Steckern nur flache Drähte (gestrichelter Rahmen).&lt;br&gt;Die Bauteile sind Gruppen. Beim Verschieben im 2,54-mm-Raster bleiben (30 Pixel), die Drähte hängen an den Pins." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="350" y="1111.5" width="510" height="260" as="geometry"/></mxCell><mxCell id="n2" value="Vor dem Löten am echten Teil prüfen&lt;br&gt;1. S3: Reihenabstand 10 Raster (25,4 mm), aus dem Foto bestimmt.&lt;br&gt;2. Pfostenstecker: Die Gehäuse dürfen höchstens 2,54 mm dick sein, sonst passen sie nicht übereinander.&lt;br&gt;3. MAX13487-Modul: rund 20 x 51 mm reserviert, aus dem Foto geschätzt. Klemmen-Reihenfolge ablesen.&lt;br&gt;4. MAX13487-Modul: TXD muss zum IC-Pin 4 (DI) gehen, RXD zu Pin 1 (RO). Sonst die Drähte an TXD und RXD tauschen.&lt;br&gt;5. ADuM1201-Modul: Reihenabstand 4 Raster, aus dem Foto geschätzt.&lt;br&gt;6. TJA1050-Modul: Reihenfolge VCC, TX, RX, GND laut Händler. Auf dem Foto ist nur RX neben GND zu sehen.&lt;br&gt;7. TJA1050-Modul: Es hat 120 Ω (Aufdruck 121). Entfernen, solange der Bus an beiden Enden schon abgeschlossen ist.&lt;br&gt;8. B0505S: 1 GND, 2 Vin, 3 0V, 4 +Vo laut Mornsun. Andere Hersteller können abweichen.&lt;br&gt;9. VE.Bus: Vor dem Anschluss A gegen B messen, Lötbrücke 120_S offen lassen." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#111111;fontSize=11;" vertex="1" parent="lText"><mxGeometry x="890" y="1111.5" width="670" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
