<mxCell id="d_p2" value="Pack 2, isoliert" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=bottom;spacingLeft=4;fontColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1315" y="395" width="275" height="190" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;ESP32-S3-WROOM-1 N16R8&lt;/b&gt; (Board mit 2 × USB-C)&lt;br&gt;&lt;br&gt;&lt;b&gt;UART1&lt;/b&gt;: GPIO 4 RX, 5 TX → VE.Bus, 256000 Bd&lt;br&gt;&lt;b&gt;TWAI&lt;/b&gt;: GPIO 13 RX, 14 TX → CAN JK-BMS, 500 kbit/s&lt;br&gt;&lt;b&gt;SPI2&lt;/b&gt;: GPIO 42 SI, 41 SO, 38 SCLK, CS GPIO 2 → SC16IS752, CS GPIO 10 → W5500&lt;br&gt;&lt;b&gt;SPI3&lt;/b&gt;: GPIO 8 CSB, 3 SDIO, 46 SCLK, 9 FCSB → CMT2300A&lt;br&gt;&lt;b&gt;UART2&lt;/b&gt;: GPIO 7 RX → MT681 Haus, 9600 Bd&lt;br&gt;&lt;b&gt;RMT&lt;/b&gt;: GPIO 6 RX → MT681 WP, 9600 Bd&lt;br&gt;&lt;b&gt;I²C&lt;/b&gt;: GPIO 16 SDA, 15 SCL → 2 × BME280&lt;br&gt;&lt;b&gt;GPIO 11&lt;/b&gt; → Relaistreiber Lüfter&lt;br&gt;&lt;b&gt;GPIO 12&lt;/b&gt; → Relaistreiber Relais 2&lt;br&gt;&lt;b&gt;USB-Host&lt;/b&gt;: GPIO 19 D−, 20 D+ → X8 USB-C → CH348&lt;br&gt;&lt;b&gt;GPIO 21&lt;/b&gt; → 5-V-Schalter für X8&lt;br&gt;&lt;b&gt;UART0&lt;/b&gt;: GPIO 43, 44 → COM-USB-C, Konsole und Flashen&lt;br&gt;&lt;b&gt;GPIO 48&lt;/b&gt;: RGB-LED auf dem Board&lt;br&gt;&lt;b&gt;WLAN&lt;/b&gt;: ioBroker per MQTT, Webseite, OTA&lt;br&gt;&lt;br&gt;&lt;b&gt;E-Paper&lt;/b&gt;: GPIO 1 BUSY, 18 RST, 17 DC, 47 CS, 40 MOSI, 39 SCK → X10&lt;br&gt;W5500: CS GPIO 10, RST an RST des Boards, INT frei&lt;br&gt;Nicht beschalten: 0, 45 (Strapping), 33–37 (PSRAM)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="175" width="380" height="520" as="geometry"/></mxCell>
