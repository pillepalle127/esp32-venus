<mxfile host="drawio"><diagram id="block" name="Blockdiagramm"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="5" guides="1" page="1" pageWidth="1800" pageHeight="1100"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="ESP_venus, Platine: Blockdiagramm mit Funktionszuordnung (Platine klein, USB frei, Stand 17.11.2026). Pfeile zeigen die Signalrichtung. Gestrichelt: Massebereiche, ADuM1201 und B0505S liegen auf der Grenze." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="-60" width="1700" height="40" as="geometry"/></mxCell>
<mxCell id="pcb" value="Platine. Alles außerhalb der gestrichelten Bereiche liegt auf der Masse des S3 (5 V, 3V3, GND)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;strokeWidth=3;align=left;verticalAlign=top;spacingLeft=6;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="1390" height="870" as="geometry"/></mxCell>
<mxCell id="d_ve" value="VE.Bus-Seite, isoliert" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#b85450;strokeWidth=2;align=left;verticalAlign=bottom;spacingLeft=4;fontColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="245" y="175" width="265" height="190" as="geometry"/></mxCell>
